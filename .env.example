APP_NAME=jwt-risk-auth
ENVIRONMENT=local

DATABASE_URL=postgresql+psycopg://jwt_user:jwt_password@localhost:5432/jwt_risk_auth

JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=jwt-risk-auth
JWT_AUDIENCE=jwt-risk-auth-users
ACCESS_TOKEN_EXPIRE_MINUTES=30
CHALLENGE_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=7

ORIGINAL_POINT_THRESHOLD=3.5
ORIGINAL_PERCENTAGE_THRESHOLD=80
AUTH_DECISION_MODE=original

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
MAIL_DEBUG_FALLBACK_ENABLED=true
